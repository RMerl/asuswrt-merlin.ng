config BCM_GPON
    tristate "Support for GPON"
    depends on BCM96858 || BCM963158 || BCM96856 || BCM96855 || BCM96888 || BCM96813 || BCM968880 || BCM96837 || BCM968375

config BCM_NGPON
    tristate "Support for XGPON/XGS/NGPON2 stack"
    depends on BCM96858 || BCM96856 || BCM963158 || BCM96855 || BCM96888 ||BCM96813 || BCM968880 || BCM96837 || BCM968375

config BCM_BUILD_NGPON_AMD2
    bool "989.3AMD2 / 9807.1AMD1 support"
    depends on (BCM96858 || BCM96856 || BCM963158 || BCM96855 || BCM96888 || BCM96813 || BCM968880 || BCM96837 || BCM968375)
    default y

config BCM_MAX_GEM_PORTS
    int "Number of Gem Ports"
    depends on BCM_GPON
    range 32 256
    default 32

config BCM_GPON_IMPL
    int "Implementation index for GPON"
    depends on BCM_GPON

config BCM_GPON_STACK
    tristate 'Support for GPON Stack Driver'
    depends on BCM96858 || BCM963158 || BCM6855 || BCM96888 || BCM96813 || BCM968880 || BCM96837 || BCM968375
    help
      Say 'M' to include support for GPON Stack driver.
      Static compile not supported.

