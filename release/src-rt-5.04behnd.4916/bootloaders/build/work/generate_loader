#!/usr/bin/env perl

use strict;
use warnings;
use Getopt::Long;
use Data::Dumper;
use bytes;
use File::Basename;


my $usage = q[
Usage: generate_loader --layout=$(bcm_uboot_layout) --out=$(FLASHIMG) $(objdir)/binaries/*.bin_headered

];

my $out;
my $layout;
my $obuff = '';
my $ptr = 0;
my $ldrsize = 0;
my %files;
my $splprefix = '';
my $nopad = 0;

GetOptions("out=s" , \$out,"layout=s",\$layout, "splprefix:s", \$splprefix) or die("$usage");
die($usage) unless ($out && $layout);

while (my $f = shift @ARGV) {
	$f =~ /^(.*?)\/([\-\.\w]+)$/;
	$files{$2} = $f;
}

open(L,"<$layout") or die("cant open $layout");
open(OF,">$out") or die("cant open $out");
open(OFM,">${out}.map") or die("cant open ${out}.map");

print OFM "loader layout $layout map file: offset, Binary, (size)\n";
print OFM "----------------------------------------------\n";

while (my $line = <L>) {
    $ptr = ($ptr + 4095) & ~4095;
    print "at $ptr\n";
    print $line;
    $line =~ s/\s*#.*$//;
    $line =~ s/\s*$//;
    my $pf = $splprefix . $line;
    if (($files{$line}) || (!$files{$pf})) {
        $pf = $line;
    }
    # set total loader size, if we exceed this we error out
    if ($line =~ /^loader:\s*(\d+)([MK]?)\s*$/i) {
        my $mult = $1;
        $mult = $mult * 1024 if ($2 && (uc($2) eq 'K'));
        $mult = $mult * 1024 * 1024 if ($2 && (uc($2) eq 'M'));
        $ldrsize = $mult;
        printf("loader region size %d\n",$ldrsize);
        $obuff = chr(255) x 8388608;
    } elsif ($line =~ /^offset:\s*(\d+)([MK]?)\s*$/i) {
    	# set offset size, pad to offset unless we've already exceeded it
        my $mult = $1;
        $mult = $mult * 1024 if ($2 && (uc($2) eq 'K'));
        $mult = $mult * 1024 * 1024 if ($2 && (uc($2) eq 'M'));
        if ($ptr <= $mult) {
            printf OFM "Pad by %d bytes\n",$mult - $ptr;
            $ptr = $mult;
        } else {
            printf("already %d beyond %d\n",$ptr - $mult, $mult);
        }
    } elsif ($line =~ /^point:\s*(\d+)([MK]?)\s*$/i) {
        # go to this point even if we have gone past, this allows multiple copies that
        # may go past a boundary to be truncated
        my $mult = $1;
        $mult = $mult * 1024 if ($2 && (uc($2) eq 'K'));
        $mult = $mult * 1024 * 1024 if ($2 && (uc($2) eq 'M'));
        if ($mult > $ptr) {
            printf("point to %d\n",$mult);
            printf OFM "point to %d bytes\n",$mult;
        } else {
            printf("truncate to %d\n",$mult);
            printf OFM "truncate to %d bytes\n",$mult;
        }
        $ptr = $mult;
    } elsif ($line =~ /^check:\s*(\d+)([MK]?)\s*$/i) {
        # check boundary, error out if we are beyond this point but don't adjust pointer
        my $mult = $1;
        $mult = $mult * 1024 if ($2 && (uc($2) eq 'K'));
        $mult = $mult * 1024 * 1024 if ($2 && (uc($2) eq 'M'));
        printf OFM "check we are within %d bytes\n",$mult;
        if ($ptr > $mult) {
            printf("already %d beyond boundary %d\n",$ptr - $mult, $mult);
            die();
        }
    } elsif ($line =~ /^align:\s*(\d+)([MK]?)\s*$/i) {
        # set alignment, align to this amount to avoid being in same block
        my $mult = $1;
        $mult = $mult * 1024 if ($2 && (uc($2) eq 'K'));
        $mult = $mult * 1024 * 1024 if ($2 && (uc($2) eq 'M'));
        my $val = int(($ptr + $mult - 1) / $mult);
        $mult = $val * $mult;
        printf OFM "pad by %d bytes\n",$mult - $ptr;
        $ptr = $mult;
    } elsif ($line =~ /^nopad:\s*(\d+)$/i) {
        # define if we need to pad image to ldrsize
        $nopad = $1;
    } elsif ( ($pf =~ /\w/ ) && ($files{$pf}) && (-r $files{$pf})) {
        print "add $files{$pf}\n";
        local $/;
        open(F,"<",$files{$pf}) or die("cant open file for $pf");
        my $f = <F>;
        my $flen = length($f);
        printf OFM "0x%08x %s (%d bytes)\n",$ptr,basename($files{$pf}),$flen;
        substr($obuff,$ptr,$flen) = $f;
        $ptr = $ptr + $flen;
    }
}
printf OFM "end at 0x%08x\n",$ptr;
if ($ptr > $ldrsize) {
    die("loader binary exceeded the size of loader region");
}
if ($nopad == 1) {
    print OF substr($obuff, 0, $ptr);
} else {
    print OF substr($obuff, 0, $ldrsize);
}

