/dts-v1/;

#include "bcm63178.dtsi"

/ {
	model = "Broadcom bcm963178";
	compatible = "broadcom,bcm963178", "brcm,bcm963178";
	#address-cells = <0x1>;
	#size-cells = <0x1>;

	aliases {
		serial0 = &uart0;
		spi1 = &hsspi;
	};


	chosen {
		stdout-path = "serial0:115200n8";
	};

	memory {
		device_type = "memory";
		reg = <0x0 0x08000000>;
	};
};

&uart0 {
	status = "okay";
};

&nand_controller {
	brcm,wp-not-connected;
	status = "okay";
};

&nandcs {
	nand-on-flash-bbt;
	brcm,nand-ecc-use-strap;
};

&hsspi {
	status = "okay";
	spi-nand {
		pinctrl-0 = <&spim_ss0_b_pin_79>;
		pinctrl-names = "default";
		compatible = "spi-nand";
		reg = <0>;
		#address-cells = <1>;
		#size-cells = <0>;
		bootph-all;
		spi-max-frequency = <100000000>;
	};
	spi-nor@0 {
		pinctrl-0 = <&spim_ss0_b_pin_79>;
		pinctrl-names = "default";
		compatible = "jedec,spi-nor";
		reg = <0>;
		#address-cells = <1>;
		#size-cells = <0>;
		spi-max-frequency = <50000000>;
		bootph-all;
	};
};

&usb0 {
	status = "okay";
	pinctrl-0 = <&usb0_pwr_pins>;
	pinctrl-names="default";
};

&usb1 {
	status = "okay";
	pinctrl-0 = <&usb1_pwr_pins>;
	pinctrl-names="default";
};