/dts-v1/;

#include "bcm6765.dtsi"

/ {
	model = "Broadcom BCM96765 Reference Board";
	compatible = "brcm,bcm96765", "brcm,bcm6765", "brcm,bcmbca";

	aliases {
		serial0 = &uart0;
		spi1 = &hsspi;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	memory {
		device_type = "memory";
		reg = <0x0 0x0 0x0 0x08000000>;
	};
};

&uart0 {
	status = "okay";
};

&nand_controller {
	brcm,wp-not-connected;
	status = "okay";
};

&nandcs {
	nand-on-flash-bbt;
	brcm,nand-ecc-use-strap;
};

&hsspi {
	status = "okay";
	spi-nand {
		compatible = "spi-nand";
		reg = <0>;
		pinctrl-0 = <&spim_ss0_b_pin_43>;
		pinctrl-names = "default";
		#address-cells = <1>;
		#size-cells = <0>;
		bootph-all;
		spi-max-frequency = <50000000>;
	};
	spi-nor@0 {
		pinctrl-0 = <&spim_ss0_b_pin_43>;
		pinctrl-names = "default";
		compatible = "jedec,spi-nor";
		reg = <0>;
		#address-cells = <1>;
		#size-cells = <0>;
		spi-max-frequency = <50000000>;
		bootph-all;
	};
};
