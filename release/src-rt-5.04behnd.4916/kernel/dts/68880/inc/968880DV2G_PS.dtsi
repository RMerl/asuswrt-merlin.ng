#include "68880.dtsi"
#include "../../bcm_voice.dtsi"

/ {
    memory_controller {
       compatible = "brcm,bcm-memc";
       memcfg = <(BP1_DDR_MCBSEL_FORMAT_VER1   | \
                  BP1_DDR_TYPE_LPDDR4         | \
                  BP1_DDR_SPEED_2133_36_39_39 | \
                  BP1_DDR_WIDTH_32BIT         | \
                  BP1_DDR_TOTAL_SIZE_16Gb      | \
                  BP1_DDR_SSC_CONFIG_1        | \
                  BP1_DDR_CONFIG_DEBUG)>;
    };
};

/ {
    xfp_sfp: xfp_sfp {
        pinctrl-names = "default", "tx-sd";
        pinctrl-0 = <&pon_lbe_p_pin_30>;
        pinctrl-1 = <&pon_lbe_p_pin_30 &rogue_onu_in_pin_27>;
        compatible = "brcm,sfp";
        i2c-bus = <&i2c0mux2>;
        los-gpio = <&gpioc 26 GPIO_ACTIVE_HIGH>;
        mod-def0 = <&bca_extintr 76 GPIO_ACTIVE_LOW (BCA_EXTINTR_TYPE_BOTH_EDGE | BCA_EXTINTR_TYPE_SENSE_EDGE)>;
        tx-power-gpio = <&gpioc 6 GPIO_ACTIVE_HIGH>;
        tx-power-down-gpio = <&gpiocext_u26 6 GPIO_ACTIVE_HIGH>;
        rx-power-gpio = <&gpiocext_u53 6 GPIO_ACTIVE_HIGH>;
        status = "disabled";
    };

    i2cmux:i2cmux {
        compatible = "i2c-mux-gpio";
        #address-cells = <1>;
        #size-cells = <0>;
        mux-gpios = <&gpiocext_u26 7 GPIO_ACTIVE_HIGH>;
        i2c-parent = <&i2c0>;
        status = "disabled";

        i2c0mux1: i2c@1 {
            reg = <0>;
            #address-cells = <1>;
            #size-cells = <0>;
        };

        i2c0mux2: i2c@2 {
            reg = <1>;
            #address-cells = <1>;
            #size-cells = <0>;
        };
    };
};

&wdt {
	status = "okay";
};

&uart0 {
	status = "okay";
};

#ifndef CONFIG_BRCM_SMC_BOOT
&nand {
    status = "okay";
};
&sdhci {
    status = "okay";
};
#endif

&phy_wan_serdes {
    status = "okay";
};

&mpcs {
    status = "okay";
};

&xport {
    status = "okay";
};

&egphy {
    status = "okay";
};

&unimac {
    status = "okay";
};

&serdes {
    status = "okay";
};

&ethphytop {
    xphy0-enabled;
    xphy1-enabled;
    wakeup-trigger-pin = <&bca_extintr 11 GPIO_ACTIVE_LOW (BCA_EXTINTR_SHARED_GPIO | BCA_EXTINTR_TYPE_LOW_LEVEL | BCA_EXTINTR_TYPE_SENSE_EDGE)>;

    power-wan-gpios =
        <&gpiocext_u54  2 GPIO_ACTIVE_HIGH>, /* 0.875V WAN power */
        <&gpiocext_u54  3 GPIO_ACTIVE_HIGH>; /* 1.2V WAN power */
    power-xphy-gpios =
        <&gpiocext_u54  1 GPIO_ACTIVE_HIGH>, /* 1.88V XPHY power */
        <&gpiocext_u54  4 GPIO_ACTIVE_HIGH>; /* 0.8V A XPHY power */
    power-misc-gpios =
        <&gpiocext_u53 12 GPIO_ACTIVE_HIGH>, /* USB */
        <&gpiocext_u53 14 GPIO_ACTIVE_HIGH>; /* LEDS */
    status = "okay";
};

&mdio {
    status = "okay";
};

&i2c0 {
    pinctrl-0 = <&i2c_scl_pin_28 &i2c_sda_pin_29>;
    pinctrl-names = "default";
    status = "okay";

    gpiocext_u26: gpio@26 {
        compatible = "nxp,pca9557";
        reg = <0x1e>;
        #gpio-cells = <2>;
        gpio-controller;
        polarity = <0x00>;
    };

    gpiocext_u54: gpio@54 {
        compatible = "nxp,pca9555";
        reg = <0x27>;
        #gpio-cells = <2>;
        gpio-controller;
        polarity = <0x00>;
    };

    gpiocext_u53: gpio@53 {
        compatible = "nxp,pca9555";
        reg = <0x20>;
        #gpio-cells = <2>;
        gpio-controller;
        polarity = <0x00>;
    };

    ina236@41 {
        compatible = "ti,ina231";
        reg = <0x41>;
        shunt-resistor = <7000>;
        status = "okay";
    };
};

&usb_ctrl {
    pinctrl-names = "default";
    pinctrl-0 = <&usb0_pwr_pins &usb1_pwr_pins>;
    xhci-enable;
    status = "okay";
};

&usb0_xhci {
    status = "okay";
    usb_port1: port1 {
        reg = <1>;
        #trigger-source-cells = <0>;
    };

    usb_port2: port2 {
        reg = <2>;
        #trigger-source-cells = <0>;
    };
};

&mdio_bus {
    serdes00_xphy {
        reg = <0x1c>;
        enet-phy-lane-swap;
        USXGMII-S;
        phy-magic = <&bca_extintr 12 GPIO_ACTIVE_LOW (BCA_EXTINTR_TYPE_LOW_LEVEL | BCA_EXTINTR_TYPE_SENSE_EDGE)>;
        phy-link  = <&bca_extintr 13 GPIO_ACTIVE_LOW (BCA_EXTINTR_TYPE_LOW_LEVEL | BCA_EXTINTR_TYPE_SENSE_EDGE)>;
        phy-power = <&gpiocext_u53 5 GPIO_ACTIVE_HIGH>; /* SLAN PHY power */
        phy-reset = <&gpiocext_u53 10 GPIO_ACTIVE_HIGH>; /* SLAN PHY reset */
    };
    serdes10_xphy {
        enet-phy-lane-swap;
        caps-no-10000;
        caps-no-5000;
        USXGMII-S;
        phy-power = <&gpiocext_u53  4 GPIO_ACTIVE_LOW>; /* QLAN PHY power */
        phy-reset = <&gpiocext_u53 11 GPIO_ACTIVE_HIGH>; /* QLAN PHY reset */
    };
    serdes11_xphy {
        enet-phy-lane-swap;
        caps-no-10000;
        caps-no-5000;
        USXGMII-S;
    };
    serdes12_xphy {
        enet-phy-lane-swap;
        caps-no-10000;
        caps-no-5000;
        USXGMII-S;
    };
    serdes10 {
        phy-handle = <&serdes10_xphy>;
    };
    serdes11 {
        phy-handle = <&serdes11_xphy>;
    };
    serdes12 {
        phy-handle = <&serdes12_xphy>;
    };
    wan_xphy {
        enet-phy-lane-swap;
        1000-Base-X;
        2500-Base-X;
        5000-Base-R;
        10000-Base-R;
        phy-power = <&gpiocext_u53 13 GPIO_ACTIVE_HIGH>; /* AE PHY power */
        phy-reset = <&gpiocext_u53  9 GPIO_ACTIVE_HIGH>; /* AE PHY reset */
    };
};

&led_ctrl {
    pinctrl-names = "default";
    pinctrl-0 = <&a_ser_led_data_pin_0 &a_ser_led_clk_pin_1 &a_ser_led_mask_pin_2>;
    serial-shifters-installed = <3>;

    led0: serial-port_gphy0-led_1 {
        active_low;
        crossbar-output = <2>;
        activity = <(LED_SPEED_GBE)>;
        status = "okay";
    };

    led1: serial-port_gphy0-led_0 {
        active_low;
        crossbar-output = <3>;
        link = <(LED_SPEED_GBE)>;
        status = "okay";
    };

    led2: serial-port_gphy1-led_1 {
        active_low;
        crossbar-output = <1>;
        activity = <(LED_SPEED_GBE)>;
        status = "okay";
    };

    led3: serial-port_gphy1-led_0 {
        active_low;
        crossbar-output = <7>;
        link = <(LED_SPEED_GBE)>;
        status = "okay";
    };

    led4: serial-port_gphy2-led_1 {
        active_low;
        crossbar-output = <14>;
        activity = <(LED_SPEED_GBE)>;
        status = "okay";
    };

    led5: serial-port_gphy2-led_0 {
        active_low;
        crossbar-output = <0>;
        link = <(LED_SPEED_GBE)>;
        status = "okay";
    };

    led6: serial-port_gphy3-led_1 {
        active_low;
        crossbar-output = <12>;
        activity = <(LED_SPEED_GBE)>;
        status = "okay";
    };

    led7: serial-port_gphy3-led_0 {
        active_low;
        crossbar-output = <13>;
        link = <(LED_SPEED_GBE)>;
        status = "okay";
    };

    led8: serial-port_xgphy0-led_1 {
        active_low;
        crossbar-output = <11>;
        activity = <(LED_SPEED_100|LED_SPEED_1G|LED_SPEED_2500|LED_SPEED_10G)>;
        status = "okay";
    };

    led9: serial-port_xgphy0-led_0 {
        active_low;
        crossbar-output = <15>;
        link = <(LED_SPEED_100|LED_SPEED_1G|LED_SPEED_2500|LED_SPEED_10G)>;
        status = "okay";
    };

    led10: serial-port_xgphy1-led_1 {
        active_low;
        crossbar-output = <9>;
        activity = <(LED_SPEED_100|LED_SPEED_1G|LED_SPEED_2500|LED_SPEED_10G)>;
        status = "okay";
    };

    led11: serial-port_xgphy1-led_0 {
        active_low;
        crossbar-output = <10>;
        link = <(LED_SPEED_100|LED_SPEED_1G|LED_SPEED_2500|LED_SPEED_10G)>;
        status = "okay";
    };


    led14: sw_serial_led_31 {
        active_low;
        label = "WAN";
        crossbar-output = <4>;
        status = "okay";
    };

    led15: sw_serial_led_30 {
        active_low;
        label = "ALARM";
        crossbar-output = <5>;
        status = "okay";
    };

    led16: sw_serial_led_29 {
        active_low;
        label = "PON";
        crossbar-output = <6>;
        status = "okay";
    };

    led17: sw_serial_led_27 {
        active_low;
        crossbar-output = <16>;
        status = "okay";
    };

    led18: sw_serial_led_26 {
        active_low;
        crossbar-output = <17>;
        status = "okay";
    };

    led19: sw_serial_led_24 {
        active_low;
        crossbar-output = <18>;
        label = "WPS";
        status = "okay";
    };

    led20: sw_serial_led_23 {
        active_low;
        crossbar-output = <19>;
        label = "VOIP2";
        status = "okay";
    };

    led21: sw_serial_led_22 {
        active_low;
        crossbar-output = <20>;
        label = "VOIP1";
        status = "okay";
    };

    led22: sw_serial_led_21 {
        active_low;
        crossbar-output = <21>;
        label = "USB0";
        trigger-sources = <&usb_port1>;
        linux,default-trigger = "usbport";
        status = "okay";
    };

    led23: sw_serial_led_20 {
        active_low;
        crossbar-output = <22>;
        label = "USB1";
        trigger-sources = <&usb_port2>;
        linux,default-trigger = "usbport";
        status = "okay";
    };
};

&switch0 {
    pinctrl-names = "default";
    pinctrl-0 = <&a_eth_mdc_pin_59 &a_eth_mdio_pin_60>;

    ports {
        port_gphy0 {
            network-leds = <&led0 &led1>;
        };
        port_gphy1 {
            network-leds = <&led2 &led3>;
        };
        port_gphy2 {
            network-leds = <&led4 &led5>;
        };
        port_gphy3 {
            network-leds = <&led6 &led7>;
        };
        port_xgphy0 {
            network-leds = <&led8 &led9>;
        };
        port_xgphy1 {
            network-leds = <&led10 &led11>;
        };
    };
};

&bcm_voice {
    sliclist = SLICSLAC_LIST_COMMON_NOFXO;
};

&hsspi {
    status = "okay";
    voice0 {
       pinctrl-0 = <&a_spim1_ss0_b_pin_25>;
       pinctrl-names = "default";
       compatible = "bcm-spi-voice";
       reg = <0>;
       spi-max-frequency = <1024000>;
       reset-gpio = <&gpioc 9 GPIO_ACTIVE_LOW>;
       power-gpio = <&gpiocext_u53 8 GPIO_ACTIVE_HIGH>; /* VOIP power */
       spi-index = <0>;
    };
};

/ {
    /* DB */
    vreg_pcie02: vreg-pcie02 {
          compatible = "regulator-fixed";
          regulator-name = "vreg-pcie02";
          regulator-min-microvolt = <5000000>;
          regulator-max-microvolt = <5000000>;
          gpio = <&gpiocext_u26 4 GPIO_ACTIVE_LOW>;
          enable-active-low;
          regulator-boot-off;
    };

    vreg_pcie13: vreg-pcie13 {
          compatible = "regulator-fixed";
          regulator-name = "vreg-pcie13";
          regulator-min-microvolt = <5000000>;
          regulator-max-microvolt = <5000000>;
          gpio = <&gpiocext_u26 5 GPIO_ACTIVE_LOW>;
          enable-active-low;
          regulator-boot-off;
    };

    /* 3.3V */
    vreg_33_pcie0: vreg-33-pcie0 {
          compatible = "regulator-fixed";
          regulator-name = "vreg-33-pcie0";
          regulator-min-microvolt = <3300000>;
          regulator-max-microvolt = <3300000>;
          gpio = <&gpiocext_u53  0 GPIO_ACTIVE_HIGH>; /* WLAN 1B 3.3V */
          enable-active-high;
          regulator-boot-off;
    };

    vreg_33_pcie1: vreg-33-pcie1 {
          compatible = "regulator-fixed";
          regulator-name = "vreg-33-pcie1";
          regulator-min-microvolt = <3300000>;
          regulator-max-microvolt = <3300000>;
          gpio = <&gpiocext_u53  2 GPIO_ACTIVE_HIGH>; /* WLAN 2B 3.3V */
          enable-active-high;
          regulator-boot-off;
    };

    vreg_33_pcie2: vreg-33-pcie2 {
          compatible = "regulator-fixed";
          regulator-name = "vreg-33-pcie2";
          regulator-min-microvolt = <3300000>;
          regulator-max-microvolt = <3300000>;
          gpio = <&gpiocext_u54  9 GPIO_ACTIVE_HIGH>; /* WLAN 1A 3.3V */
          enable-active-high;
          regulator-boot-off;
    };

    vreg_33_pcie3: vreg-33-pcie3 {
          compatible = "regulator-fixed";
          regulator-name = "vreg-33-pcie3";
          regulator-min-microvolt = <3300000>;
          regulator-max-microvolt = <3300000>;
          gpio = <&gpiocext_u54 11 GPIO_ACTIVE_HIGH>; /* WLAN 2A 3.3V */
          enable-active-high;
          regulator-boot-off;
    };

    /* 5V */
    vreg_50_pcie0: vreg-50-pcie0 {
          compatible = "regulator-fixed";
          regulator-name = "vreg-50-pcie0";
          regulator-min-microvolt = <5000000>;
          regulator-max-microvolt = <5000000>;
          gpio = <&gpiocext_u53  1 GPIO_ACTIVE_HIGH>; /* WLAN 1B 5V */
          enable-active-high;
          regulator-boot-off;
    };

    vreg_50_pcie1: vreg-50-pcie1 {
          compatible = "regulator-fixed";
          regulator-name = "vreg-50-pcie1";
          regulator-min-microvolt = <5000000>;
          regulator-max-microvolt = <5000000>;
          gpio = <&gpiocext_u53  3 GPIO_ACTIVE_HIGH>; /* WLAN 2B 5V */
          enable-active-high;
          regulator-boot-off;
    };

    vreg_50_pcie2: vreg-50-pcie2 {
          compatible = "regulator-fixed";
          regulator-name = "vreg-50-pcie2";
          regulator-min-microvolt = <5000000>;
          regulator-max-microvolt = <5000000>;
          gpio = <&gpiocext_u54 10 GPIO_ACTIVE_HIGH>; /* WLAN 1A 5V */
          enable-active-high;
          regulator-boot-off;
    };

    vreg_50_pcie3: vreg-50-pcie3 {
          compatible = "regulator-fixed";
          regulator-name = "vreg-50-pcie3";
          regulator-min-microvolt = <5000000>;
          regulator-max-microvolt = <5000000>;
          gpio = <&gpiocext_u54 12 GPIO_ACTIVE_HIGH>; /* WLAN 2A 5V */
          enable-active-high;
          regulator-boot-off;
    };
};

&pcie0 {
      brcm,supply-names = "vreg-pcie02", "vreg-33-pcie0", "vreg-50-pcie0";
      brcm,vreg-supply = <&vreg_pcie02 &vreg_33_pcie0 &vreg_50_pcie0>;
      status = "okay";
};

&pcie1 {
      brcm,supply-names = "vreg-pcie13", "vreg-33-pcie1", "vreg-50-pcie1";
      brcm,vreg-supply = <&vreg_pcie13 &vreg_33_pcie1 &vreg_50_pcie1>;
      status = "okay";
};

&pcie2 {
      brcm,supply-names = "vreg-pcie02", "vreg-33-pcie2", "vreg-50-pcie2";
      brcm,vreg-supply = <&vreg_pcie02 &vreg_33_pcie2 &vreg_50_pcie2>;
      status = "okay";
};

&pcie3 {
      brcm,supply-names = "vreg-pcie13", "vreg-33-pcie3", "vreg-50-pcie3";
      brcm,vreg-supply = <&vreg_pcie13 &vreg_33_pcie3 &vreg_50_pcie3>;
      status = "okay";
};
