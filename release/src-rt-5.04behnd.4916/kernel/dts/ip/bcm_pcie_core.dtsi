#if defined(CONFIG_64BIT)
#define HI32    0
#else
#define HI32
#endif

#if !defined(CPU_ADDR_OFFSET)
#define CPU_ADDR_OFFSET 0
#endif

#define CPU_REG_ADDR           (PCIE_ADDR - CPU_ADDR_OFFSET)

compatible = "brcm,bcm963xx-pcie";
device_type = "pci";
#if defined(PCIE_ECAM_ADDR)
#define CPU_ECAM_ADDR          (PCIE_ECAM_ADDR - CPU_ADDR_OFFSET)
reg-names = "core-base", "ecam-base";
reg = <HI32 CPU_REG_ADDR HI32 PCIE_SIZE>,
      <HI32 CPU_ECAM_ADDR HI32 PCIE_ECAM_SIZE>;
#else
reg-names = "core-base";
reg = <HI32 CPU_REG_ADDR HI32 PCIE_SIZE>;
#endif

#address-cells = <3>;
#size-cells = <2>;

#if defined(PCIE_RANGE)
ranges = <PCIE_RANGE>;
#else
#define CPU_RANGE_ADDR         (PCIE_RANGE_ADDR - CPU_ADDR_OFFSET)
/*       <flags(32b)> <pci_addr(64b)>   <cpu_addr(64b)  > <size(64)>      */
ranges = <0x02000000  0 PCIE_RANGE_ADDR HI32 CPU_RANGE_ADDR 0 PCIE_RANGE_SIZE>;
#endif

/* core error log interrupts */
interrupt-names = "intr";
interrupts = <GIC_SPI PCIE_SPI IRQ_TYPE_LEVEL_HIGH>;

#interrupt-cells = <1>;
interrupt-map-mask = <0 0 0 0>;
interrupt-map = <0 0 0 0 &gic GIC_SPI PCIE_SPI IRQ_TYPE_LEVEL_HIGH>;

brcm,coreid = <PCIE_ID>;
#if defined(PCIE_DOMAIN_ID)
linux,pci-domain = <PCIE_DOMAIN_ID>;
#else
linux,pci-domain = <PCIE_ID>;
#endif
bus-range = <0 1>;

status = "disabled";

/* to let add multiple pcie without errors undefine pcie definitions */
#undef PCIE_ID
#undef PCIE_DOMAIN_ID
#undef PCIE_SPI
#undef PCIE_ADDR
#undef PCIE_SIZE
#undef PCIE_ECAM_ADDR
#undef PCIE_ECAM_SIZE
#undef PCIE_RANGE
#undef PCIE_RANGE_ADDR
#undef PCIE_RANGE_SIZE
#undef CPU_RANGE_ADDR
#undef CPU_REG_ADDR
#undef CPU_ECAM_ADDR
#undef HI32

