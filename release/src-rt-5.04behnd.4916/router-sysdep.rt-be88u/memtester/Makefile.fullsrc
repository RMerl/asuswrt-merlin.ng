#***********************************************************************
#
# memtester - userspace utility for testing the memory subsystem.
#
# Ported from bcm963xx userspace/gpl/apps/memtester (upstream release
# memtester-4.5.0, GPL v2).  Built with the toolchain/flags from
# make.common instead of the upstream conf-cc/conf-ld script mechanism.
#
#***********************************************************************/

#
# In most cases, you only need to modify this first section.
#
EXE  = memtester
OBJS = memtester.o tests.o
LIBS =

all install: $(EXE) generic_exe_install

clean: generic_clean
	rm -f $(INSTALL_DIR)/bin/$(EXE)

#
# Set our CommEngine directory (by splitting the pwd into two words
# at /userspace and taking the first word only).
# Then include the common defines under CommEngine.
#
CURR_DIR := $(shell pwd)
BUILD_DIR:=$(HND_SRC)

include $(BUILD_DIR)/make.common

#
# Compile flags taken from the original bcm963xx GPL build (conf-cc).
#
CUSTOM_CFLAGS += -O2 -DPOSIX -D_POSIX_C_SOURCE=200809L -D_FILE_OFFSET_BITS=64 -DTEST_NARROW_WRITES

#
# Implicit rule will make the .c into a .o
# Implicit rule is $(CC) -c $(CPPFLAGS) $(CFLAGS)
# See Section 10.2 of Gnu Make manual
#
$(EXE): $(OBJS)
	$(CC) $(BCM_LD_FLAGS) -o $@ $(OBJS) $(CMS_RPATH_OPTION) $(CMS_LIB_PATH) $(LIBS)

#
# Include the rule for making dependency files.
# The '-' in front of the second include suppresses
# error messages when make cannot find the .d files.
# It will just regenerate them.
# See Section 4.14 of Gnu Make.
#
include $(BUILD_DIR)/make.deprules

-include $(OBJS:.o=.d)
