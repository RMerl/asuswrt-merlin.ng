diff -Naur obuspa_orig/src/core/handle_get.c obuspa_new/src/core/handle_get.c
--- obuspa_orig/src/core/handle_get.c	2024-07-29 13:04:17.522221033 -0700
+++ obuspa_new/src/core/handle_get.c	2024-07-29 15:07:50.642113186 -0700
@@ -76,6 +76,15 @@
 Usp__GetResp__ResolvedPathResult__ResultParamsEntry *
 AddResolvedPathRes_ParamsEntry(Usp__GetResp__ResolvedPathResult *resolved_path_res, char *param_name, char *value);
 
+#ifdef BDK_USP
+#include <unistd.h>
+
+#define DATAELM_HOLD_FILE "/var/hold_dataelm"
+
+#define ROOT_FULL_PATH "Device."
+#define WIFI_FULL_PATH "Device.WiFi."
+#endif
+
 /*********************************************************************//**
 **
 ** MSG_HANDLER_HandleGet
@@ -99,6 +108,9 @@
     unsigned depth;
     group_get_vector_t ggv;
     get_expr_info_t *get_expr_info;
+#ifdef BDK_USP
+    int disableWifiDataUpdate = 0;
+#endif
 
     // Exit if message is invalid or failed to parse
     // This code checks the parsed message enums and pointers for expectations and validity
@@ -140,6 +152,30 @@
     GROUP_GET_VECTOR_Init(&ggv);
     for (i=0; i < num_path_expr; i++)
     {
+#ifdef BDK_USP
+        /*
+         * This is a workaround to avoid the WiFi Service Element instance
+         * mismatch between the refresh of instance and the get operation of
+         * these instances.
+         * For example, obuspa calls the vendor code to refresh instance of wifi
+         * an object, and gets instances 1, 2 and 3. obuspa then issues get
+         * parameter values of instances 1, 2, 3 from the vendor. However, in
+         * between the refresh and the get operations, wifi data element daemon
+         * could scan the network and update the wifi object instances. To avoid
+         * this, a file is written for wifi data element daemon to read so it
+         * won't update the object instances until it's clear to do so.
+         */
+        if ((disableWifiDataUpdate == 0) &&
+            (!strcmp(path_exprs[i], ROOT_FULL_PATH) ||
+             !strcmp(path_exprs[i], WIFI_FULL_PATH)))
+        {
+            char cmd[128]={0};
+
+            snprintf(cmd, sizeof(cmd), "echo 1 > %s", DATAELM_HOLD_FILE);
+            system(cmd);
+            disableWifiDataUpdate = 1;
+        }
+#endif
         ExpandGetPathExpression(i, path_exprs[i], (int)depth, &get_expr_info[i], &ggv);
     }
 
@@ -152,6 +188,16 @@
         FormPathExprResponse(i, path_exprs[i], &get_expr_info[i], &ggv, resp);
     }
 
+#ifdef BDK_USP
+    if (disableWifiDataUpdate != 0)
+    {
+        /*
+         * remove the file, wifi data element daemon is cleared to update
+         * scanned result to the vendor wifi data model.
+         */
+        unlink(DATAELM_HOLD_FILE);
+    }
+#endif
     GROUP_GET_VECTOR_Destroy(&ggv);
 
     // Clean up get_expr_info vector
diff -Naur obuspa_orig/src/core/group_add_vector.c obuspa_new/src/core/group_add_vector.c
--- obuspa_orig/src/core/group_add_vector.c	2024-07-29 13:04:17.522221033 -0700
+++ obuspa_new/src/core/group_add_vector.c	2024-08-06 15:03:37.883049997 -0700
@@ -458,6 +458,12 @@
     group_set_entry_t *src;
     group_add_param_t *dest;
     group_add_param_t *ps;
+#ifdef BDK_USP
+    bool isParamUniqueKey(group_set_entry_t *src, dm_unique_key_vector_t *uniqueKeyVector);
+    dm_unique_key_vector_t uniqueKeyVector = {0};
+    bool isErrorUniqueKey = 0;
+    int uniqueKeyErr = USP_ERR_OK;
+#endif    
 
     GROUP_SET_VECTOR_Init(&gsv);
 
@@ -480,6 +486,11 @@
         GROUP_SET_VECTOR_Add(&gsv, full_path, ps->value, ps->is_required, combined_role);
     }
 
+#ifdef BDK_USP    
+    // Get list of unique key for this fullpath
+    DATA_MODEL_GetUniqueKeys(gae->res_path,&uniqueKeyVector);
+#endif    
+    
     // Perform the set of the parameters for this object
     GROUP_SET_VECTOR_SetValues(&gsv, 0, gsv.num_entries);
 
@@ -494,6 +505,16 @@
             dest->err_code = src->err_code;
             dest->err_msg = USP_STRDUP(src->err_msg); // NOTE: We cannot just move the string between the structures, because the string needs to stay in the group set vector as it maybe used by DATA_MODEL_ValidateDefaultedUniqueKeys
 
+#ifdef BDK_USP
+            /* In BDK, a unique key could be autogenerated, so the value is not always NULL.
+             * This will fail the check of uniqueKey being NULL.  We will intercept here first.
+             */
+            if (!isErrorUniqueKey)
+            {
+                isErrorUniqueKey = isParamUniqueKey(src,&uniqueKeyVector);
+                uniqueKeyErr = dest->err_code;
+            }
+#endif
             if (dest->is_required)
             {
                 RollbackGroupAddEntry(gae);
@@ -508,8 +529,23 @@
 
     // Exit if unable to get the parameter values of the unique keys for this object
     full_path[len] = '\0';
-    err = DATA_MODEL_GetUniqueKeyParams(full_path, &gae->unique_keys, combined_role);
-    if (err != USP_ERR_OK)
+
+#ifdef BDK_USP
+    /* In BDK, we autogen the unique key, so the unique key value may not be NULL, 
+     * we intercept the error here */
+    if (isErrorUniqueKey)
+    {
+        err = uniqueKeyErr;
+    }
+    else
+    {
+        err = DATA_MODEL_GetUniqueKeyParams(full_path, &gae->unique_keys, combined_role);        
+    }
+#else
+    err = DATA_MODEL_GetUniqueKeyParams(full_path, &gae->unique_keys, combined_role);    
+#endif
+
+    if (err != USP_ERR_OK)        
     {
         RollbackGroupAddEntry(gae);
         goto exit;
@@ -572,3 +608,31 @@
     USP_SNPRINTF(path, sizeof(path), "%s.%d", gae->res_path, gae->instance);
     DATA_MODEL_DeleteInstance(path, 0);
 }
+
+#ifdef BDK_USP
+bool isParamUniqueKey(group_set_entry_t *src, dm_unique_key_vector_t *uniqueKeyVector)
+{
+    int i = 0;
+    bool isUniqueKey = 0;
+    dm_unique_key_t *key;
+    
+    if (uniqueKeyVector != NULL)
+    {
+        key = uniqueKeyVector->vector;
+        for (i=0; i < MAX_COMPOUND_KEY_PARAMS; i++)
+        {
+            if (key->param[i] == NULL)
+            {
+                break;
+            }
+            /* src->path is the full path of the parameter, the uniqueKeyVector contain the parameter name only */
+            if (strstr(src->path,key->param[i]) != NULL)
+            {
+                isUniqueKey = 1;
+                break;
+            }
+        }
+    }
+    return (isUniqueKey);
+}
+#endif
