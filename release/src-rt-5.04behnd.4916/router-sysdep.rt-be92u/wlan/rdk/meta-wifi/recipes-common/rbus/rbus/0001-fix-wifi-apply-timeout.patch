+#define RBUS_WIFI_APPLY_TIMEOUT_ENV "/proc/environment/rbus_wifi_apply_timeout"
+#define RBUS_WIFI_APPLY_TIMEOUT_DEFAULT 120 /* seconds */
+
+typedef struct _rbus_component_timeout {
+    char *reg_match; /*component's regex match string */
+    char *environment_name;
+    int  default_timeout; /* In seconds */
+} RBUS_COMPONENT_TIMEOUT;
+
+/* Component matching table */
+RBUS_COMPONENT_TIMEOUT g_components_timeout[] = {
+    { "^Device\\.WiFi\\.Radio\\.[1-9]\\.X_CISCO_COM_ApplySetting$", RBUS_WIFI_APPLY_TIMEOUT_ENV, 120 },
+};
+
+#define RBUS_COMPENT_TIMEOUT_SIZE ((int)(sizeof(g_components_timeout)/sizeof(RBUS_COMPONENT_TIMEOUT)))
+
+/* return component timeout in ms */
+int rbus_getComponentTimeout(const char *name)
+{
+    int timeout = 0;
+    regex_t regex;
+
+    for (int i = 0; i < RBUS_COMPENT_TIMEOUT_SIZE; ++i) {
+        if (!regcomp(&regex, g_components_timeout[i].reg_match, REG_EXTENDED) &&
+                !regexec(&regex,name, 0, NULL, 0)) {
+            if (g_components_timeout[i].environment_name != NULL) {
+                FILE *ev_file = fopen(g_components_timeout[i].environment_name, "r");
+                if (ev_file)
+                {
+                    char buffer[64]={0};
+                    size_t bytes_read = fread(buffer, 1, sizeof(buffer), ev_file);
+                    if (bytes_read > 0)
+                    {
+                        timeout = atoi(buffer);
+                    }
+                    fclose(ev_file);
+                }
+            }
+            if (timeout == 0)
+            {
+                timeout = g_components_timeout[i].default_timeout;
+            }
+            regfree(&regex);
+            break;
+        }
+    }
+    return timeout * 1000;
+}
